#!/bin/sh
# Seroga OS sistēmas iestatījumi
set -e

# --- Latviešu valoda un laika josla ---
sed -i 's/^# *lv_LV.UTF-8/lv_LV.UTF-8/; s/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen
locale-gen
cat > /etc/default/locale <<EOF
LANG=lv_LV.UTF-8
LANGUAGE=lv:en
EOF
cat > /etc/default/keyboard <<EOF
XKBMODEL="pc105"
XKBLAYOUT="lv,us"
XKBVARIANT="apostrophe,"
XKBOPTIONS="grp:alt_shift_toggle"
BACKSPACE="guess"
EOF
ln -sf /usr/share/zoneinfo/Europe/Riga /etc/localtime
echo "Europe/Riga" > /etc/timezone

# --- Sistēmas nosaukums ---
cat > /etc/os-release <<EOF
PRETTY_NAME="Seroga OS 1.0"
NAME="Seroga OS"
VERSION_ID="1.0"
VERSION="1.0 (uz Debian 13 bāzes)"
ID=seroga
ID_LIKE=debian
HOME_URL="https://github.com/SerogaMaslo/seroga-os"
LOGO=seroga-os
EOF
echo "Seroga OS 1.0 \\n \\l" > /etc/issue

# --- Ātrdarbība: zram (kā Android), mazāka swap izmantošana ---
if [ -f /etc/default/zramswap ]; then
  sed -i 's/^#\?ALGO=.*/ALGO=zstd/; s/^#\?PERCENT=.*/PERCENT=50/' /etc/default/zramswap
fi
echo "vm.swappiness=100" > /etc/sysctl.d/90-seroga.conf
systemctl enable zramswap.service 2>/dev/null || true
systemctl enable earlyoom.service 2>/dev/null || true

# --- Flathub (lietotņu veikals, kā Play/Microsoft Store) ---
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

# --- Pieteikšanās ekrāns ---
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/seroga.conf <<EOF
[Theme]
Current=breeze

[General]
Numlock=on
EOF

# --- Seroga lietotņu ceļš ---
chmod +x /opt/seroga/bin/* 2>/dev/null || true
echo 'PATH="/opt/seroga/bin:$PATH"' > /etc/profile.d/seroga.sh

# Notīra pagaidu sarakstu
rm -f /usr/share/seroga/optional-packages.list
apt-get clean
