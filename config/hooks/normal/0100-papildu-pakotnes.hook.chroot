#!/bin/sh
# Instalē pakotnes no saraksta, ja tās eksistē. Trūkstoša pakotne būvēšanu neaptur.
set -e
LIST=/usr/share/seroga/optional-packages.list
[ -f "$LIST" ] || exit 0
export DEBIAN_FRONTEND=noninteractive

grep -v '^\s*#' "$LIST" | grep -v '^\s*$' | while read -r pkg; do
  if apt-cache show "$pkg" >/dev/null 2>&1; then
    apt-get install -y --no-install-recommends "$pkg" || echo "BRĪDINĀJUMS: neizdevās instalēt $pkg"
  else
    echo "Izlaižu (nav krātuvē): $pkg"
  fi
done
