#!/bin/bash
# =====================================================================
#  Seroga lietotņu instalētājs / atjauninātājs
#
#  Gatavā sistēmā (kā root):
#      seroga-atjaunot-lietotnes
#
#  ISO būvēšanas laikā (no repo saknes):
#      seroga-atjaunot-lietotnes --build config/includes.chroot config/packages.chroot
#
#  Neobligāti: GITHUB_TOKEN vide — lai neiedurtos GitHub API limitā.
# =====================================================================
set -u

MODE=system
ROOT=""
DEBDIR=""
if [ "${1:-}" = "--build" ]; then
  MODE=build
  ROOT="$(realpath "$2")"
  DEBDIR="$(realpath "$3")"
fi

CONF="$ROOT/usr/share/seroga/lietotnes.conf"
APPS="$ROOT/opt/seroga/apps"
DESKTOP="$ROOT/usr/share/applications"
BIN="$ROOT/opt/seroga/bin"
LIST="$APPS/saraksts.txt"

[ -f "$CONF" ] || { echo "Nav atrasts saraksts: $CONF"; exit 1; }
for t in curl jq tar unzip; do
  command -v "$t" >/dev/null || { echo "Trūkst rīks: $t"; exit 1; }
done
if [ "$MODE" = system ] && [ "$(id -u)" -ne 0 ]; then
  echo "Palaid ar sudo."; exit 1
fi

mkdir -p "$APPS" "$DESKTOP" "$BIN"
[ -n "$DEBDIR" ] && mkdir -p "$DEBDIR"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

AUTH=()
[ -n "${GITHUB_TOKEN:-}" ] && AUTH=(-H "Authorization: Bearer $GITHUB_TOKEN")

ok=0; skip=0
{
  echo "Seroga OS — iebūvētās lietotnes"
  echo "Atjaunināts: $(date '+%Y-%m-%d %H:%M')"
  echo
} > "$TMP/saraksts.txt"

TAB=$'\t'

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; echo "${s%"${s##*[![:space:]]}"}"; }

is_elf() { [ -f "$1" ] && [ "$(head -c4 "$1" | tr -d '\0' | tail -c3)" = "ELF" ]; }

write_desktop() { # id name comment exec icon
  cat > "$DESKTOP/$1.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$2
Comment=$3
Exec=$4
Icon=$5
Terminal=false
Categories=X-Seroga;
StartupWMClass=$1
EOF
}

while IFS='|' read -r id name repo desc icon; do
  id="$(trim "$id")"
  case "$id" in ''|\#*) continue ;; esac
  name="$(trim "$name")"; repo="$(trim "$repo")"; desc="$(trim "$desc")"; icon="$(trim "$icon")"

  echo "── $name ($repo)"
  json="$(curl -fsSL "${AUTH[@]}" -H "Accept: application/vnd.github+json" \
          "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null)" || {
    echo "   izlaižu: repo vai release nav atrasts"; skip=$((skip+1)); continue; }

  tag="$(jq -r '.tag_name // "?"' <<<"$json")"
  assets="$(jq -r '.assets[] | "\(.name)\t\(.browser_download_url)"' <<<"$json")"

  pick() { grep -iE "$1" <<<"$assets" | grep -viE 'arm64|aarch64|armhf|arm-' | head -n1; }
  line="$(pick '\.deb'"$TAB")"; kind=deb
  [ -z "$line" ] && { line="$(pick '\.appimage'"$TAB")"; kind=appimage; }
  [ -z "$line" ] && { line="$(pick 'linux.*\.(tar\.gz|tgz|tar\.xz)'"$TAB")"; kind=tar; }
  [ -z "$line" ] && { line="$(pick 'linux.*\.zip'"$TAB")"; kind=zip; }
  if [ -z "$line" ]; then
    echo "   izlaižu: release $tag nav Linux faila (.deb/.AppImage/linux .tar.gz/.zip)"
    skip=$((skip+1)); continue
  fi

  file="${line%%"$TAB"*}"; url="${line#*"$TAB"}"
  echo "   lejupielādēju $file ($tag)"
  curl -fsSL "${AUTH[@]}" -o "$TMP/$file" "$url" || { echo "   lejupielāde neizdevās"; skip=$((skip+1)); continue; }

  case "$kind" in
    deb)
      if [ "$MODE" = build ]; then
        cp "$TMP/$file" "$DEBDIR/"
      else
        apt-get install -y "$TMP/$file" || { echo "   instalēšana neizdevās"; skip=$((skip+1)); continue; }
      fi
      ;;
    appimage)
      rm -rf "${APPS:?}/$id"; mkdir -p "$APPS/$id"
      install -m755 "$TMP/$file" "$APPS/$id/$id.AppImage"
      ln -sf "/opt/seroga/apps/$id/$id.AppImage" "$BIN/$id"
      write_desktop "$id" "$name" "$desc" "/opt/seroga/apps/$id/$id.AppImage" "$icon"
      ;;
    tar|zip)
      rm -rf "$TMP/x"; mkdir -p "$TMP/x"
      if [ "$kind" = tar ]; then tar -xf "$TMP/$file" -C "$TMP/x"; else unzip -q "$TMP/$file" -d "$TMP/x"; fi
      # Ja arhīvā ir viena mape — ieejam tajā (piem. bundle/)
      src="$TMP/x"
      while [ "$(ls -A "$src" | wc -l)" -eq 1 ] && [ -d "$src/$(ls -A "$src")" ]; do src="$src/$(ls -A "$src")"; done
      exe=""
      for f in "$src"/*; do
        if is_elf "$f" && [[ "$(basename "$f")" != *.so* ]]; then exe="$(basename "$f")"; break; fi
      done
      if [ -z "$exe" ]; then
        echo "   izlaižu: arhīvā nav atrasts palaižamais fails"; skip=$((skip+1)); continue
      fi
      rm -rf "${APPS:?}/$id"; mkdir -p "$APPS/$id"
      cp -a "$src"/. "$APPS/$id/"
      chmod +x "$APPS/$id/$exe"
      ln -sf "/opt/seroga/apps/$id/$exe" "$BIN/$id"
      ic="$icon"
      [ -f "$APPS/$id/$icon" ] && ic="/opt/seroga/apps/$id/$icon"
      write_desktop "$id" "$name" "$desc" "/opt/seroga/apps/$id/$exe" "$ic"
      ;;
  esac

  echo "   ✓ gatavs"
  printf '✓ %-24s %s  (%s)\n' "$name" "$tag" "$desc" >> "$TMP/saraksts.txt"
  ok=$((ok+1))
done < "$CONF"

cp "$TMP/saraksts.txt" "$LIST"
echo
echo "Iebūvētas: $ok   Izlaistas: $skip"
[ "$MODE" = system ] && command -v update-desktop-database >/dev/null && update-desktop-database "$DESKTOP" || true
exit 0
