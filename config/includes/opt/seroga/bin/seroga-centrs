#!/bin/bash
# Seroga Centrs — Seroga OS vadības centrs
# Palīdz ieslēgt Android lietotnes, Windows programmas, spēles un atjaunināt Seroga lietotnes.

TITLE="Seroga Centrs"
FIRST_RUN_FLAG="$HOME/.config/seroga/pirma-palaisana-pabeigta"

msg()  { kdialog --title "$TITLE" --msgbox "$1"; }
ask()  { kdialog --title "$TITLE" --yesno "$1"; }
err()  { kdialog --title "$TITLE" --error "$1"; }

run_root() {
  # Palaiž komandu ar administratora tiesībām terminālī, lai redzētu progresu
  konsole --hold -e bash -c "echo '== $1 =='; sudo bash -c \"$2\"; echo; echo 'Gatavs. Logu var aizvērt.'"
}

android() {
  if ! command -v waydroid >/dev/null; then
    err "Waydroid nav instalēts šajā sistēmā."
    return
  fi
  ask "Ieslēgt Android lietotnes?\n\nTiks lejupielādēta Android sistēma (~1 GB) ar Google Play pakalpojumiem.\nTam vajag interneta savienojumu un dažas minūtes." || return
  run_root "Android ieslēgšana" "systemctl enable --now waydroid-container && waydroid init -s GAPPS -f"
  msg "Android ir gatavs!\n\nAndroid lietotnes parādīsies Start izvēlnē.\nAPK failu var instalēt ar: waydroid app install fails.apk"
}

windows() {
  ask "Instalēt Bottles?\n\nBottles ļauj ērti palaist Windows programmas (.exe) — katrai programmai sava 'pudele' ar Wine." || return
  konsole --hold -e bash -c "flatpak install -y --user flathub com.usebottles.bottles; echo; echo 'Gatavs.'"
  msg "Windows programmas: atver Bottles vai vienkārši dubultklikšķi uz .exe faila."
}

speles() {
  ask "Instalēt Steam?\n\nSteam ar Proton palaiž lielāko daļu Windows spēļu." || return
  konsole --hold -e bash -c "flatpak install -y --user flathub com.valvesoftware.Steam; echo; echo 'Gatavs.'"
}

atjauninat_seroga() {
  if [ -x /opt/seroga/bin/seroga-atjaunot-lietotnes ]; then
    run_root "Seroga lietotņu atjaunināšana" "/opt/seroga/bin/seroga-atjaunot-lietotnes"
  else
    err "Atjaunināšanas rīks nav atrasts."
  fi
}

atjaunosanas_punkts() {
  if command -v timeshift-launcher >/dev/null; then
    timeshift-launcher &
  else
    err "Timeshift nav instalēts."
  fi
}

seroga_lietotnes() {
  if [ -f /opt/seroga/apps/saraksts.txt ]; then
    kdialog --title "Iebūvētās Seroga lietotnes" --textbox /opt/seroga/apps/saraksts.txt 520 420
  else
    msg "Šajā versijā vēl nav iebūvētu Seroga lietotņu."
  fi
}

# Pirmā palaišana: piedāvā visu sagatavot
if [ "$1" = "--pirma-palaisana" ]; then
  [ -f "$FIRST_RUN_FLAG" ] && exit 0
  mkdir -p "$(dirname "$FIRST_RUN_FLAG")"
  touch "$FIRST_RUN_FLAG"
  msg "Sveiks, $(whoami)! Laipni lūdzam Seroga OS.\n\nTūlīt atvērsies Seroga Centrs — tur vari ieslēgt Android lietotnes, Windows programmas un spēles.\n\nSeroga Centru vienmēr atradīsi Start izvēlnē."
fi

LIVE=0
grep -q 'boot=casper' /proc/cmdline 2>/dev/null && LIVE=1

if [ "$1" = "--pirma-palaisana" ] && [ "$LIVE" = 1 ]; then
  ask "Tu izmanto Seroga OS no USB (live režīmā).\n\nVai vēlies instalēt Seroga OS uz šī datora tagad?\n(Var arī vispirms izmēģināt un instalēt vēlāk no Seroga Centra.)" \
    && exec /opt/seroga/bin/seroga-instalet
fi

while true; do
  INSTALL_ITEM=()
  [ "$LIVE" = 1 ] && INSTALL_ITEM=(instalet "💿  Instalēt Seroga OS uz šī datora")
  choice=$(kdialog --title "$TITLE" --menu "Ko darīsim?" \
    "${INSTALL_ITEM[@]}" \
    android  "📱  Ieslēgt Android lietotnes (Waydroid)" \
    windows  "🪟  Windows programmas (Bottles)" \
    speles   "🎮  Spēles (Steam)" \
    lietotnes "⭐  Manas Seroga lietotnes" \
    atjaunot "🔄  Atjaunināt Seroga lietotnes" \
    punkts   "🛟  Sistēmas atjaunošanas punkti (Timeshift)" \
    veikals  "🛍️  Lietotņu veikals (Discover)" \
    iestat   "⚙️  Sistēmas iestatījumi") || exit 0

  case "$choice" in
    instalet) /opt/seroga/bin/seroga-instalet & ;;
    android)  android ;;
    windows)  windows ;;
    speles)   speles ;;
    lietotnes) seroga_lietotnes ;;
    atjaunot) atjauninat_seroga ;;
    punkts)   atjaunosanas_punkts ;;
    veikals)  plasma-discover & ;;
    iestat)   systemsettings & ;;
  esac
done
